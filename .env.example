# Shared PostgreSQL database used by the API and worker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zepto_research

# API
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:4000

# Worker
WORKER_POLL_INTERVAL_MS=2000
SOURCE_FETCH_USER_AGENT=ZeptoNextLeapResearch/0.1 (+public-research; contact=replace-before-deploy)
MAX_SOURCE_BYTES=1000000
MAX_NORMALIZED_CHARACTERS=20000

# Groq. Leave blank to collect sources without analysis; the run will truthfully
# end as partially completed and can be retried after a key is supplied.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional public-web discovery. The UI reports Tavily as unavailable when blank.
TAVILY_API_KEY=

# Frontend (Vercel)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
