# Database. Required by API, worker, migration, and import commands.
DATABASE_URL=

# Explicit AI provider selection. No automatic fallback occurs.
AI_PROVIDER=gemini

# Required only when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=

# Required only when AI_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=

# Optional public-web discovery.
TAVILY_API_KEY=

# Future optional integrations. These are placeholders only in Phase 1.
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=
APIFY_GOOGLE_PLAY_ACTOR_ID=

# API
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Worker
WORKER_POLL_INTERVAL_MS=3000
SOURCE_FETCH_USER_AGENT=ZeptoNextLeapResearch/0.1 (+public-research; contact=replace-before-deploy)
MAX_SOURCE_BYTES=1000000
MAX_NORMALIZED_CHARACTERS=60000

# Frontend (Vercel)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
