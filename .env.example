# Database. Required by API, worker, migration, and import commands.
DATABASE_URL=

# Explicit AI provider selection. No automatic fallback occurs.
AI_PROVIDER=gemini

# Required only when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=

# Required only when AI_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=

# Optional public-web discovery.
TAVILY_API_KEY=

# Optional Firecrawl public-URL ingestion.
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT_MS=60000

# Optional Google Play request timeout.
GOOGLE_PLAY_TIMEOUT_MS=5000

# Optional zero-cost research discovery and explicit-URL extraction.
# Both features are disabled by default; the key is not required otherwise.
TINYFISH_API_KEY=
TINYFISH_SEARCH_ENABLED=false
TINYFISH_FETCH_ENABLED=false
TINYFISH_SEARCH_MAX_RESULTS=5
TINYFISH_MAX_SEARCH_REQUESTS_PER_RUN=10
TINYFISH_FETCH_MAX_URLS_PER_RUN=10
TINYFISH_REQUEST_TIMEOUT_MS=30000
TINYFISH_MAX_RETRIES=1

# Future optional integrations. These are not implemented.
APIFY_API_TOKEN=
APIFY_GOOGLE_PLAY_ACTOR_ID=

# API
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Worker
WORKER_POLL_INTERVAL_MS=3000
SOURCE_FETCH_USER_AGENT=ZeptoNextLeapResearch/0.1 (+public-research; contact=replace-before-deploy)
MAX_SOURCE_BYTES=1000000
MAX_NORMALIZED_CHARACTERS=60000

# Structured analysis scale limits. Batches are sequential.
ANALYSIS_EVIDENCE_MAX_DOCUMENTS_PER_BATCH=50
ANALYSIS_EVIDENCE_MAX_ESTIMATED_PROMPT_TOKENS_PER_BATCH=32000
ANALYSIS_THEME_MAX_EVIDENCE_PER_BATCH=100
ANALYSIS_THEME_MAX_ESTIMATED_PROMPT_TOKENS_PER_BATCH=32000
ANALYSIS_THEME_MAX_PROVISIONAL_PER_BATCH=40
ANALYSIS_INSIGHT_MAX_EVIDENCE_PER_BATCH=100
ANALYSIS_INSIGHT_MAX_ESTIMATED_PROMPT_TOKENS_PER_BATCH=32000
MVP_SOURCE_CONCENTRATION_WARNING_THRESHOLD=0.6

# Operational category-expansion research readiness thresholds.
# These are project review gates, not statistical sufficiency claims.
RESEARCH_READINESS_MIN_RELEVANT_RECORDS=100
RESEARCH_READINESS_MIN_SOURCES=3
RESEARCH_READINESS_MAX_SOURCE_CONCENTRATION=0.75
RESEARCH_READINESS_MIN_CATEGORIES=3
RESEARCH_READINESS_MAX_CATEGORY_CONCENTRATION=0.75
RESEARCH_READINESS_MIN_BARRIERS_OR_RISKS=20
RESEARCH_READINESS_MIN_TRIGGERS_OR_TRUST_SIGNALS=10
RESEARCH_READINESS_MIN_ABANDONMENT_OR_WORKAROUNDS=10

# Frontend (Vercel)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
