{
  "name": "@zepto/research-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude src/database-validation.test.ts --exclude src/gemini-integration.test.ts --exclude src/adapters/firecrawl.integration.test.ts --exclude src/adapters/google-play.integration.test.ts",
    "test:db": "vitest run src/database-validation.test.ts",
    "test:firecrawl": "vitest run src/adapters/firecrawl.integration.test.ts",
    "test:gemini": "vitest run src/gemini-integration.test.ts",
    "test:google-play": "vitest run src/adapters/google-play.integration.test.ts",
    "test:scale": "vitest run src/analysis-scale.test.ts",
    "scale:live": "tsx src/analysis-scale-live.ts",
    "pilot:import": "tsx src/import-manual-pilot.ts"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@zepto/research-contracts": "workspace:*",
    "@zepto/research-database": "workspace:*",
    "@zepto/research-prompts": "workspace:*",
    "@zepto/shared-config": "workspace:*",
    "cheerio": "^1.2.0",
    "csv-parse": "^6.1.0",
    "drizzle-orm": "^0.45.2",
    "google-play-scraper": "10.1.3",
    "groq-sdk": "^1.3.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
